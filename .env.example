# --- Server ---
PORT=2006

# --- Auth / JWT ---
ACCESS_TOKEN_SECRET=your-access-token-secret

# --- Database ---
DATABASE_URL=mongodb://localhost:27017/your-db-name

# --- Kafka ---
# local = plaintext Docker; aiven = SASL_SSL (set KAFKA_MODE=aiven + SASL/CA vars)
KAFKA_MODE=local
KAFKA_BROKERS=localhost:9092
KAFKA_SASL_USERNAME=your-aiven-username
KAFKA_SASL_PASSWORD=your-aiven-password
KAFKA_SASL_MECHANISM=scram-sha-256
KAFKA_SSL_CA_PATH=./ca.pem
KAFKA_SSL_CA=

# --- Inter-service ---
FRIEND_ID_FETCH_URL=http://localhost:2000/api/v1/user/friend/friends/ids

# --- Email (Gmail) ---
GOOGLE_APP_PASSWORD=your-google-app-password
MY_EMAIL=your-email@example.com
